# =============================================================================
# Kova Media Group — environment template
#
# Copy this file to `.env.local` and fill in the values:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real values.
#
# The authoritative schema is `src/env.ts`. Every variable below is REQUIRED —
# a missing or malformed value fails the BUILD, not the first request, so you
# will find out immediately rather than in production.
#
# NODE_ENV is deliberately absent: Next.js sets it, and setting it by hand
# causes more problems than it solves.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. DATABASE — Supabase Postgres
# -----------------------------------------------------------------------------
# Supabase dashboard → Connect (top bar) → ORMs / Prisma.
# Copy the two strings Supabase shows you rather than hand-assembling them; the
# host, port and region differ per project and Supabase has changed the format
# across releases (docs/DECISIONS.md OD-1).
#
# Two DIFFERENT connections, and mixing them up produces failures that only
# appear under load in production:
#
#   DATABASE_URL  → POOLED (Supavisor, transaction mode, usually port 6543).
#                   Used by the app at runtime. Serverless functions open and
#                   discard connections constantly, so pooling is mandatory.
#
#   DIRECT_URL    → DIRECT (usually port 5432). Used by Prisma Migrate and the
#                   seed script, which issue statements a pooler cannot proxy.
#
# Remember to URL-encode special characters in the password.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"


# -----------------------------------------------------------------------------
# 2. SUPABASE — auth and file storage
# -----------------------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
#
# Supabase is the identity provider and file store only. It never serves
# application data — Prisma does (docs/DECISIONS.md ADR-004).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# Also used to derive the allowed image host in next.config.ts.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Anon / publishable key. Reaches the browser by design.
# Safe to expose: every application table has RLS enabled with no permissive
# policies, and the anon role's grants are revoked (ADR-006). This key can read
# nothing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role key. SERVER ONLY — never prefix with NEXT_PUBLIC_, never log it.
# Used to issue signed upload URLs and to read uploaded objects back for
# metadata extraction. This key bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=""


# -----------------------------------------------------------------------------
# 3. EMAIL — Resend
# -----------------------------------------------------------------------------
# resend.com → API Keys. "Sending access" is sufficient.

RESEND_API_KEY=""

# Where contact form notifications are delivered — i.e. your inbox.
CONTACT_NOTIFICATION_EMAIL="hello@kovamediagroup.com"

# The From address. Must be on a domain you have verified in Resend, or
# delivery will silently fail.
MAIL_FROM_EMAIL="website@kovamediagroup.com"


# -----------------------------------------------------------------------------
# 4. APPLICATION
# -----------------------------------------------------------------------------
# Canonical origin. Drives metadata, the sitemap, password-reset links, and the
# Server Action origin allowlist. No trailing slash.
#   local:      http://localhost:3000
#   production: https://kovamediagroup.com

NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# 5. SECRETS — generate these yourself
# -----------------------------------------------------------------------------
# Each must be at least 32 characters. Generate a fresh one per value, and use
# DIFFERENT values per environment (local / preview / production):
#
#     openssl rand -base64 32
#
# Never reuse one of these for another, and never commit them.

# Guards the Draft Mode entry route (/api/preview) for callers without an
# admin session. Compared in constant time.
PREVIEW_SECRET=""

# Salt for hashing visitor IPs before they are stored for rate limiting.
# MUST be secret and MUST NOT be a constant: an unsalted hash of an IPv4
# address is reversible by enumerating all four billion of them, which would
# defeat the entire point of not storing the address.
IP_HASH_SALT=""

# Guards POST /api/revalidate, the external cache-invalidation hook.
REVALIDATE_SECRET=""


# =============================================================================
# NOT an environment variable, but required before the media library works:
#
#   Supabase dashboard → Storage → New bucket
#     Name:   media
#     Public: yes (published assets are served from the CDN)
#
# Writes are only possible through server-issued signed upload URLs, so a
# public bucket is read-only from the outside.
# =============================================================================
